---
import type { ArticleEntry } from '../lib/content';
import { formatDate } from '../lib/content';
import TagList from './TagList.astro';

interface Props {
  article: ArticleEntry;
}

const { article } = Astro.props;
const href = `/articles/${article.id}/`;
const articleData = article.data as typeof article.data & {
  thumbnail?: { src: string; alt: string };
};
const thumbnail = articleData.thumbnail;
---

<article class="article-card">
  <a class="card-thumbnail" href={href} aria-label={`Read ${article.data.title}`}>
    {
      thumbnail ? (
        <img src={thumbnail.src} alt={thumbnail.alt} loading="lazy" decoding="async" />
      ) : (
        <span class="card-thumbnail-fallback" aria-hidden="true">
          <span>{article.data.title.slice(0, 1)}</span>
        </span>
      )
    }
  </a>
  <div class="card-meta">
    <time datetime={article.data.pubDate.toISOString()}>
      {formatDate(article.data.pubDate)}
    </time>
    {
      article.data.series && (
        <span aria-label="Series">Series: {article.data.series}</span>
      )
    }
  </div>
  <div class="archive-entry-body">
    <h3><a href={href}>{article.data.title}</a></h3>
    <p class="card-description">{article.data.description}</p>
  </div>
  <TagList tags={article.data.tags} />
</article>
