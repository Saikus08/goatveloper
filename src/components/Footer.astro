---
import { site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span>{year} {site.author}</span>
  <nav class="footer-links" aria-label="Contact and footer links">
    <a href={`mailto:${site.contact.email}`}>Email</a>
    <a href={site.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    <a href={site.contact.github} target="_blank" rel="noreferrer">GitHub</a>
    <a href="/resume/">Resume</a>
    <a href="/rss.xml">RSS</a>
  </nav>
</footer>
