---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  getAllTags,
  isPublishedEntry,
  sortByNewest,
} from '../../lib/content';

const articles = sortByNewest(
  (await getCollection('articles')).filter(isPublishedEntry),
);
const tags = getAllTags(articles);
const featuredArticle = articles.find((article) => article.data.featured) ?? articles[0];
const remainingArticles = articles.filter((article) => article.id !== featuredArticle?.id);
---

<BaseLayout
  title="Articles"
  description="Technical articles, learning notes, and software engineering reflections."
>
  <section class="page-section page-header page-header-essay">
    <p class="eyebrow">Writing</p>
    <h1>Articles</h1>
    <p class="page-lede">
      Notes from building, debugging, and studying the parts of software
      engineering that become clearer when written down.
    </p>
    {
      tags.length > 0 && (
        <div class="topic-strip">
          <span class="micro-label">Topics</span>
          <ul class="tag-list" aria-label="All tags">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={`/tags/${tag.slug}/`}>
                  {tag.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  {
    featuredArticle && (
      <section
        class="page-section page-feature"
        aria-labelledby="pinned-article"
        data-bleed-line
      >
        <div class="section-intro">
          <p class="eyebrow">Pinned</p>
          <h2 id="pinned-article">Start with this note</h2>
        </div>
        <article class="spotlight-card">
          <div class="spotlight-meta">
            <span class="spotlight-label">Latest note</span>
            <time datetime={featuredArticle.data.pubDate.toISOString()}>
              {formatDate(featuredArticle.data.pubDate)}
            </time>
          </div>
          <div class="spotlight-copy">
            <h3>
              <a href={`/articles/${featuredArticle.id}/`}>
                {featuredArticle.data.title}
              </a>
            </h3>
            <p>{featuredArticle.data.description}</p>
          </div>
          <div class="spotlight-footer">
            <ul class="tag-list" aria-label="Pinned article tags">
              {featuredArticle.data.tags.map((tag) => (
                <li>
                  <span class="tag">{tag}</span>
                </li>
              ))}
            </ul>
            <a class="button primary" href={`/articles/${featuredArticle.id}/`}>
              Read article
            </a>
          </div>
        </article>
      </section>
    )
  }

  {
    remainingArticles.length > 0 && (
      <section class="page-section" aria-label="Article archive" data-bleed-line>
        <div class="section-intro">
          <h2>Archive</h2>
        </div>
        <ul class="archive-list">
          {remainingArticles.map((article) => <li><ArticleCard article={article} /></li>)}
        </ul>
      </section>
    )
  }

  {
    articles.length === 0 && (
      <section
        class="page-section"
        aria-labelledby="articles-empty-state"
        data-bleed-line
      >
        <div class="empty-state">
          <h2 id="articles-empty-state">Writing will appear here soon</h2>
          <p>
            This archive is intentionally small right now. More notes will show
            up here as the work becomes worth publishing.
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
