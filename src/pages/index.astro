---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { resume } from '../data/resume';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  type ArticleEntry,
  formatDate,
  isPublishedEntry,
  sortByNewest,
  sortProjectsByNewest,
} from '../lib/content';
import { site } from '../lib/site';

const publishedArticles = sortByNewest(
  (await getCollection('articles')).filter(isPublishedEntry),
);
const featuredArticle: ArticleEntry | undefined =
  publishedArticles.find((article) => article.data.featured) ??
  publishedArticles[0];
const articleArchive = publishedArticles
  .filter((article) => article.id !== featuredArticle?.id)
  .slice(0, 3);
const projects = sortProjectsByNewest(
  (await getCollection('projects')).filter(isPublishedEntry),
);
const currentProject = projects[0];
---

<BaseLayout
  title={site.name}
  description={site.description}
  bodyClass="page-home"
>
  <div class="home-shell">
    <div class="home-atmosphere" aria-hidden="true">
      <div class="home-mesh">
        <span class="home-mesh-shape home-mesh-shape-one"></span>
        <span class="home-mesh-shape home-mesh-shape-two"></span>
        <span class="home-mesh-shape home-mesh-shape-three"></span>
        <span class="home-mesh-noise"></span>
      </div>

      <svg
        class="home-tracker"
        viewBox="0 0 100 220"
        preserveAspectRatio="none"
      >
        <path
          class="home-tracker-line"
          d="M72 18C64 24 58 31 55 41C52 53 58 62 66 70C74 78 75 88 69 97C62 107 49 114 45 125C41 137 47 146 56 154C64 161 67 171 63 183C60 192 53 200 46 206"
        ></path>
        <circle class="home-tracker-node" cx="72" cy="18" r="1.2"></circle>
        <circle class="home-tracker-node" cx="45" cy="125" r="1.1"></circle>
        <circle class="home-tracker-node" cx="46" cy="206" r="1.2"></circle>
      </svg>
    </div>

    <section class="page-section home-hero" data-reveal style="--reveal-delay: 0ms">

      <div class="home-copy">
        <p class="eyebrow">{site.author} · {site.role}</p>
        <h1>Writing that makes the engineering visible.</h1>
        <p class="home-lede">
          Goatveloper is where I turn implementation work into articles, project
          case studies, and a public record of what I actually understood.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/articles/">Read articles</a>
          <a class="button" href="/resume/">View resume</a>
        </div>
        <p class="home-factline">
          {resume.location} · writing-first portfolio · software engineering in
          public
        </p>
      </div>

      {
        featuredArticle && (
          <article class="home-pinned">
            <div class="home-pinned-meta">
              <span class="home-pinned-label">Pinned note</span>
              <time datetime={featuredArticle.data.pubDate.toISOString()}>
                {formatDate(featuredArticle.data.pubDate)}
              </time>
            </div>
            <h2>
              <a href={`/articles/${featuredArticle.id}/`}>
                {featuredArticle.data.title}
              </a>
            </h2>
            <p>{featuredArticle.data.description}</p>
            <ul class="tag-list" aria-label="Pinned note topics">
              {featuredArticle.data.tags.map((tag) => (
                <li>
                  <span class="tag">{tag}</span>
                </li>
              ))}
            </ul>
            <a class="home-pinned-link" href={`/articles/${featuredArticle.id}/`}>
              Read the note
            </a>
          </article>
        )
      }
    </section>

    <section
      class="page-section home-essay"
      data-bleed-line
      data-reveal
      style="--reveal-delay: 70ms"
    >
      <div class="section-intro">
        <p class="eyebrow">What this is</p>
        <h2>Not a landing page. A working publication.</h2>
      </div>
      <div class="home-essay-grid">
        <p>
          Good engineering writing starts with real work: a bug, a tradeoff, a
          refactor, a system that only becomes clear when I force myself to
          explain it.
        </p>
        <p>
          The project and resume sides of this site matter because they are tied
          to the same body of work, not because they sit beside it as decoration.
        </p>
      </div>
    </section>

    {
      articleArchive.length > 0 && (
        <section
          class="page-section home-archive"
          aria-labelledby="selected-writing"
          data-bleed-line
          data-reveal
          style="--reveal-delay: 130ms"
        >
          <div class="section-heading">
            <div class="section-heading-copy">
              <p class="eyebrow">Selected writing</p>
              <h2 id="selected-writing">More from the archive</h2>
            </div>
            <a href="/articles/">All articles</a>
          </div>
          <ul class="archive-list">
            {articleArchive.map((article) => <li><ArticleCard article={article} /></li>)}
          </ul>
        </section>
      )
    }

    {
      currentProject && (
        <section
          class="page-section home-current"
          aria-labelledby="current-project"
          data-bleed-line
          data-reveal
          style="--reveal-delay: 190ms"
        >
          <div class="section-heading">
            <div class="section-heading-copy">
              <p class="eyebrow">Current project</p>
              <h2 id="current-project">Built in public</h2>
            </div>
            <a href="/projects/">All projects</a>
          </div>
          <ProjectCard project={currentProject} />
        </section>
      )
    }
  </div>
</BaseLayout>
