---
import { getCollection } from 'astro:content';
import ArticleCard from '../components/ArticleCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  type ArticleEntry,
  formatDate,
  isNoteEntry,
  isPublishedEntry,
  sortByNewest,
} from '../lib/content';
import { site } from '../lib/site';

const publishedNotes = sortByNewest(
  (await getCollection('articles')).filter(
    (article) => isPublishedEntry(article) && isNoteEntry(article),
  ),
);
const featuredArticle: ArticleEntry | undefined =
  publishedNotes.find((article) => article.data.featured) ?? publishedNotes[0];
const recentNotes = publishedNotes
  .filter((article) => article.id !== featuredArticle?.id)
  .slice(0, 3);

const featuredArticleData = featuredArticle?.data as
  | (NonNullable<typeof featuredArticle>['data'] & {
      thumbnail?: { src: string; alt: string };
    })
  | undefined;
const pinnedCarouselImages = [
  {
    src: '/profile/agustin-vignolo-thesis-presentation.jpg',
    alt: 'Agustín Vignolo presenting his degree project at a lectern.',
  },
  {
    src: '/profile/agustin-vignolo-portrait.jpg',
    alt: 'Portrait of Agustín Vignolo.',
  },
  ...(featuredArticleData?.thumbnail ? [featuredArticleData.thumbnail] : []),
];

const nowItems = [
  {
    label: 'Looking for',
    title: 'Remote backend and data roles',
    body: 'Fintech and other data-intensive products first. I work from Montevideo with good overlap with US hours.',
    href: '/resume/',
    cta: 'See my resume',
  },
  {
    label: 'Building',
    title: 'A financial data pipeline, in public',
    body: 'Starting now: a Spring Batch and Spark pipeline on a public financial dataset of 1M+ rows, with restartable ingestion, reconciliation between jobs, and data-quality rules. I will write up each step here.',
    href: '/articles/',
    cta: 'Follow the notes',
  },
  {
    label: 'Running',
    title: 'Sistaller, a SaaS in production',
    body: 'Multi-tenant software for automotive workshops. Its first workshop moved from handwritten records to exact margins per customer, vehicle and order.',
    href: '/projects/sistaller/',
    cta: 'Read about Sistaller',
  },
];

const proofPoints = [
  {
    where: 'Advisor Engine',
    what: 'Designed a data-quality monitor enforcing 18 invariants across custodian, transaction, position and cash data for a US wealth-management platform. It surfaced 10 defects.',
  },
  {
    where: 'Advisor Engine',
    what: 'Built the Jenkins pipeline that runs position reconciliation and diagnostics after every custodian daily load.',
  },
  {
    where: 'URadar',
    what: 'Technical lead on a multi-tenant TypeScript platform: 7 LangGraph agents, a RAG pipeline, and the AWS deployment with CI/CD.',
  },
  {
    where: 'Seta Workshop',
    what: 'Owned a multi-tenant Rails platform with 120+ models and upgraded it from Rails 5 to Rails 7.1.',
  },
];
---


<BaseLayout
  title={site.name}
  description={site.description}
  bodyClass="page-home"
>
  <div class="home-shell">
    <div class="home-atmosphere" aria-hidden="true">
      <div class="home-mesh">
        <span class="home-mesh-shape home-mesh-shape-one"></span>
        <span class="home-mesh-shape home-mesh-shape-two"></span>
        <span class="home-mesh-shape home-mesh-shape-three"></span>
        <span class="home-mesh-noise"></span>
      </div>

      <svg
        class="home-tracker"
        viewBox="0 0 100 220"
        preserveAspectRatio="none"
      >
        <path
          class="home-tracker-line"
          d="M72 18C64 24 58 31 55 41C52 53 58 62 66 70C74 78 75 88 69 97C62 107 49 114 45 125C41 137 47 146 56 154C64 161 67 171 63 183C60 192 53 200 46 206"
        ></path>
        <circle class="home-tracker-node" cx="72" cy="18" r="1.2"></circle>
        <circle class="home-tracker-node" cx="45" cy="125" r="1.1"></circle>
        <circle class="home-tracker-node" cx="46" cy="206" r="1.2"></circle>
      </svg>
    </div>

    <section class="page-section home-hero" data-reveal style="--reveal-delay: 0ms">
      <div class="home-copy">
        <div class="home-identity">
          <img
            class="home-avatar"
            src="/profile/agustin-vignolo-portrait.jpg"
            alt="Portrait of Agustín Vignolo"
            width="96"
            height="96"
            loading="eager"
            decoding="async"
          />
          <p class="eyebrow">{site.author} · {site.role}</p>
        </div>
        <h1>I build backend systems where the data has to be right.</h1>
        <p class="home-lede">
          I'm a software engineer with 4+ years across Ruby on Rails,
          TypeScript and the JVM. Most recently I worked on a wealth-management
          platform serving large US custodians, building reconciliation and
          data-quality checks around Spring Batch and Spark pipelines. This
          site is my resume, my projects, and what I learn along the way.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#contact">Get in touch</a>
          <a class="button" href="/articles/">Read the blog</a>
          <a class="button" href="/resume/">Resume</a>
        </div>
        <p class="home-factline">Montevideo, Uruguay · UTC-3 · Open to remote roles</p>
      </div>

      {
        featuredArticle && (
          <article class="home-pinned" data-pinned-card>
            <div class="home-pinned-inner">
              <div class="home-pinned-face home-pinned-front">
                <span class="home-pin" aria-hidden="true"></span>
                <div class="home-pinned-meta">
                  <span class="home-pinned-label">Pinned note</span>
                  <time datetime={featuredArticle.data.pubDate.toISOString()}>
                    {formatDate(featuredArticle.data.pubDate)}
                  </time>
                </div>
                <h2>
                  <a href={`/articles/${featuredArticle.id}/`}>
                    {featuredArticle.data.title}
                  </a>
                </h2>
                <p>{featuredArticle.data.description}</p>
                <ul class="tag-list" aria-label="Pinned note topics">
                  {featuredArticle.data.tags.map((tag) => (
                    <li>
                      <span class="tag">{tag}</span>
                    </li>
                  ))}
                </ul>
                <a class="home-pinned-link" href={`/articles/${featuredArticle.id}/`}>
                  Read the note
                </a>
              </div>

              <div class="home-pinned-face home-pinned-back" aria-hidden="true">
                <div class="pinned-carousel" data-pinned-carousel>
                  <div class="pinned-carousel-header">
                    <span class="home-pinned-label">Image trail</span>
                    <span data-carousel-count>1 / {pinnedCarouselImages.length}</span>
                  </div>
                  <div class="pinned-carousel-frame">
                    {pinnedCarouselImages.map((image, index) => (
                      <figure
                        class:list={["pinned-carousel-slide", { "is-active": index === 0 }]}
                        data-carousel-slide
                        aria-hidden={index === 0 ? 'false' : 'true'}
                      >
                        <img src={image.src} alt={image.alt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
                      </figure>
                    ))}
                  </div>
                  <div class="pinned-carousel-controls">
                    <button class="carousel-button" type="button" data-carousel-prev aria-label="Previous pinned note image">
                      ←
                    </button>
                    <a class="home-pinned-link" href={`/articles/${featuredArticle.id}/`}>
                      Read the note
                    </a>
                    <button class="carousel-button" type="button" data-carousel-next aria-label="Next pinned note image">
                      →
                    </button>
                  </div>
                </div>
              </div>
            </div>
            <button
              class="home-pinned-tab"
              type="button"
              data-pinned-toggle
              aria-label="Show pinned note image carousel"
              aria-pressed="false"
            >
              <span aria-hidden="true">Flip</span>
            </button>
          </article>
        )
      }
    </section>

    <section
      class="page-section home-now"
      aria-labelledby="home-now-title"
      data-bleed-line
      data-reveal
      style="--reveal-delay: 70ms"
    >
      <div class="section-intro">
        <p class="eyebrow">Now</p>
        <h2 id="home-now-title">What I'm working on</h2>
      </div>
      <ul class="now-grid">
        {nowItems.map((item) => (
          <li class="now-card">
            <span class="micro-label">{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            <a href={item.href}>
              {item.cta} <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section
      class="page-section home-proof"
      aria-labelledby="home-proof-title"
      data-bleed-line
      data-reveal
      style="--reveal-delay: 100ms"
    >
      <div class="section-heading">
        <div class="section-heading-copy">
          <p class="eyebrow">Experience</p>
          <h2 id="home-proof-title">A few things I've shipped</h2>
        </div>
        <a href="/resume/">Full resume</a>
      </div>
      <ul class="split-list">
        {proofPoints.map((point) => (
          <li>
            <strong>{point.where}</strong>
            <span>{point.what}</span>
          </li>
        ))}
      </ul>
    </section>

    {
      recentNotes.length > 0 && (
        <section
          class="page-section home-archive"
          aria-labelledby="recent-writing"
          data-bleed-line
          data-reveal
          style="--reveal-delay: 130ms"
        >
          <div class="section-heading">
            <div class="section-heading-copy">
              <p class="eyebrow">Writing</p>
              <h2 id="recent-writing">Recent notes</h2>
            </div>
            <a href="/articles/">All notes</a>
          </div>
          <ul class="archive-list">
            {recentNotes.map((article) => <li><ArticleCard article={article} /></li>)}
          </ul>
        </section>
      )
    }

    <section
      class="page-section home-contact"
      id="contact"
      aria-labelledby="home-contact-title"
      data-bleed-line
      data-reveal
      style="--reveal-delay: 160ms"
    >
      <div class="section-intro">
        <p class="eyebrow">Contact</p>
        <h2 id="home-contact-title">Hiring, or want to talk shop?</h2>
      </div>
      <p class="home-contact-lede">
        I'm looking for remote backend and data roles. Email is the fastest way
        to reach me.
      </p>
      <div class="hero-actions">
        <a class="button primary" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a class="button" href={site.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="button" href={site.contact.github} target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>

  </div>

  <script>
    const pinnedCard = document.querySelector('[data-pinned-card]');

    if (pinnedCard instanceof HTMLElement) {
      const toggle = pinnedCard.querySelector('[data-pinned-toggle]');
      const backFace = pinnedCard.querySelector('.home-pinned-back');
      const slides = [...pinnedCard.querySelectorAll('[data-carousel-slide]')];
      const count = pinnedCard.querySelector('[data-carousel-count]');
      const prev = pinnedCard.querySelector('[data-carousel-prev]');
      const next = pinnedCard.querySelector('[data-carousel-next]');
      let activeSlide = 0;

      const setSlide = (index: number) => {
        if (slides.length === 0) return;

        activeSlide = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          slide.classList.toggle('is-active', slideIndex === activeSlide);
          slide.setAttribute('aria-hidden', String(slideIndex !== activeSlide));
        });

        if (count) {
          count.textContent = `${activeSlide + 1} / ${slides.length}`;
        }
      };

      const setFlipped = (isFlipped: boolean) => {
        pinnedCard.classList.toggle('is-flipped', isFlipped);

        if (toggle instanceof HTMLButtonElement) {
          const toggleText = toggle.querySelector('span');
          toggle.setAttribute('aria-pressed', String(isFlipped));
          toggle.setAttribute(
            'aria-label',
            isFlipped ? 'Show pinned note text' : 'Show pinned note image carousel',
          );

          if (toggleText) {
            toggleText.textContent = isFlipped ? 'Back' : 'Flip';
          }
        }

        backFace?.setAttribute('aria-hidden', String(!isFlipped));
      };

      toggle?.addEventListener('click', () => {
        setFlipped(!pinnedCard.classList.contains('is-flipped'));
      });

      prev?.addEventListener('click', () => setSlide(activeSlide - 1));
      next?.addEventListener('click', () => setSlide(activeSlide + 1));
      setSlide(0);
    }
  </script>
</BaseLayout>
