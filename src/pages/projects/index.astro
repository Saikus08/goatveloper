---
import { getCollection } from 'astro:content';
import ProjectCard from '../../components/ProjectCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  isPublishedEntry,
  sortProjectsByNewest,
} from '../../lib/content';

const projects = sortProjectsByNewest(
  (await getCollection('projects')).filter(isPublishedEntry),
);
const featuredProject = projects[0];
const remainingProjects = projects.slice(1);
---

<BaseLayout
  title="Projects"
  description="Project case studies, technical decisions, and build notes."
>
  <section class="page-section page-header page-header-essay">
    <p class="eyebrow">Proof of work</p>
    <h1>Projects</h1>
    <p class="page-lede">
      Case studies for the systems behind the writing. Each one is here to show
      what was built, why it mattered, and which tradeoffs shaped the result.
    </p>
  </section>

  {
    featuredProject && (
      <section
        class="page-section page-feature"
        aria-labelledby="featured-project-case-study"
        data-bleed-line
      >
        <div class="section-intro">
          <p class="eyebrow">Pinned case study</p>
          <h2 id="featured-project-case-study">Current project</h2>
        </div>
        <article class="spotlight-card">
          <div class="spotlight-meta">
            <span class="spotlight-label">{featuredProject.data.status}</span>
            <time datetime={featuredProject.data.started.toISOString()}>
              Started {formatDate(featuredProject.data.started)}
            </time>
          </div>
          <div class="spotlight-copy">
            <h3>
              <a href={`/projects/${featuredProject.id}/`}>
                {featuredProject.data.title}
              </a>
            </h3>
            <p>{featuredProject.data.description}</p>
          </div>
          <div class="spotlight-footer">
            <ul class="tag-list" aria-label="Pinned project technologies">
              {featuredProject.data.tech.map((tech) => (
                <li>
                  <span class="tag">{tech}</span>
                </li>
              ))}
            </ul>
            <a class="button primary" href={`/projects/${featuredProject.id}/`}>
              Read case study
            </a>
          </div>
        </article>
      </section>
    )
  }

  {
    remainingProjects.length > 0 && (
      <section class="page-section" aria-label="Project archive" data-bleed-line>
        <div class="section-intro">
          <h2>Archive</h2>
        </div>
        <ul class="archive-list">
          {remainingProjects.map((project) => <li><ProjectCard project={project} /></li>)}
        </ul>
      </section>
    )
  }

  {
    projects.length === 0 && (
      <section
        class="page-section"
        aria-labelledby="projects-empty-state"
        data-bleed-line
      >
        <div class="empty-state">
          <h2 id="projects-empty-state">Project case studies will appear here soon</h2>
          <p>
            New projects will land here when there is a real problem, decision
            trail, or lesson worth documenting.
          </p>
        </div>
      </section>
    )
  }
</BaseLayout>
