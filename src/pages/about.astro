---
import { existsSync } from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const portraitPath = "/profile/agustin-vignolo-portrait.jpg";
const portraitAvailable = existsSync(
  new URL("../../public/profile/agustin-vignolo-portrait.jpg", import.meta.url),
);
---

<BaseLayout
  title="About"
  description="About Agustin Vignolo and the purpose of Goatveloper."
>
  <section class="page-section page-header page-header-essay about-hero">
    <div class="about-hero-copy">
      <p class="eyebrow">About</p>
      <h1>{site.author}</h1>
      <p class="page-lede">
        I work across product development, quality engineering, and technical
        delivery, and I’m building Goatveloper as the place where that work
        becomes clearer in public.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/articles/">Read articles</a>
        <a class="button" href="/resume/">View resume</a>
      </div>
    </div>

    <aside class="about-portrait-panel" aria-label="Portrait">
      <button
        class="about-flip-button"
        type="button"
        data-flip-card
        data-flipped="false"
        aria-pressed="false"
        aria-label="Show portrait photo"
      >
        <span class="about-flip-glow" aria-hidden="true"></span>
        <span class="about-flip-card">
          <span class="about-flip-face about-flip-front" aria-hidden="true">
            <span class="theme-logo theme-logo-themed about-flip-logo">
              <img
                class="theme-logo-asset theme-logo-light"
                src="/brand/goatveloper-full-dark.png"
                width="2048"
                height="2048"
                alt=""
                loading="eager"
                decoding="async"
              />
              <img
                class="theme-logo-asset theme-logo-dark"
                src="/brand/goatveloper-full-light.png"
                width="2048"
                height="2048"
                alt=""
                loading="eager"
                decoding="async"
              />
            </span>
          </span>

          <span class="about-flip-face about-flip-back" aria-hidden="true">
            {
              portraitAvailable ? (
                <img
                  class="about-portrait-image"
                  src={portraitPath}
                  alt=""
                  width="1024"
                  height="1024"
                  loading="eager"
                  decoding="async"
                />
              ) : (
                <span class="about-portrait-placeholder">
                  <span>AVS</span>
                </span>
              )
            }
          </span>
        </span>

        <span class="about-flip-prompt" data-flip-card-prompt>
          Show portrait
        </span>
      </button>
    </aside>
  </section>

  <section class="page-section essay-stack">
    <div class="essay-block" data-bleed-line>
      <h2>Why build it this way</h2>
      <p>
        I have learned a lot through real teams, client work, QA, product
        delivery, and building things on my own. Writing is how I turn that into
        something more precise than a list of technologies.
      </p>
      <p>
        I want the site to show how I approach decisions, quality, delivery, and
        growth over time—not only where I have worked.
      </p>
    </div>

    <div class="essay-block essay-block-split" data-bleed-line>
      <section>
        <h2>What I publish here</h2>
        <ul class="plain-list">
          <li>Notes from building and debugging.</li>
          <li>Explanations once something finally clicks.</li>
          <li>Project case studies with decisions and tradeoffs.</li>
        </ul>
      </section>

      <section>
        <h2>What I want this site to become</h2>
        <ul class="plain-list">
          <li>A body of work that feels earned.</li>
          <li>A clearer record of how I think and improve.</li>
          <li>Something another engineer might find useful.</li>
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
