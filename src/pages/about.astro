---
import { existsSync } from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/site';

const portraitPath = '/profile/agustin-vignolo-portrait.jpg';
const portraitAvailable = existsSync(
  new URL('../../public/profile/agustin-vignolo-portrait.jpg', import.meta.url),
);

const audiences = [
  'Engineers reviewing how I think through tradeoffs and implementation.',
  'Recruiters or hiring managers looking for signal that feels earned.',
  'Future collaborators who want a clearer sense of how I work.',
] as const;

const principles = [
  'Clear writing over vague technical claims.',
  'Projects explained through decisions and tradeoffs.',
  'A profile that is backed by real work, not only a polished summary.',
] as const;
---

<BaseLayout
  title="About"
  description="About Agustin Vignolo Sotelo and the purpose of Goatveloper."
>
  <section class="page-section page-header page-header-essay about-hero">
    <div class="about-hero-copy">
      <p class="eyebrow">About</p>
      <h1>{site.author}</h1>
      <p class="page-lede">
        I am building Goatveloper as a writing-first engineering site: part
        publication, part project record, part resume evidence.
      </p>
      <div class="hero-actions">
        <a class="button primary" href="/articles/">Read articles</a>
        <a class="button" href="/resume/">View resume</a>
      </div>
    </div>

    <aside class="about-portrait-panel" aria-label="Portrait">
      {
        portraitAvailable ? (
          <img
            class="about-portrait-image"
            src={portraitPath}
            alt="Portrait of Agustin Vignolo Sotelo"
            width="1024"
            height="1024"
            loading="eager"
            decoding="async"
          />
        ) : (
          <div class="about-portrait-placeholder" aria-hidden="true">
            <span>AVS</span>
          </div>
        )
      }
    </aside>
  </section>

  <section class="page-section essay-stack">
    <div class="essay-block" data-bleed-line>
      <h2>Why build it this way</h2>
      <p>
        The goal is to become a stronger software engineer by turning real work
        into writing that is specific, readable, and honest about tradeoffs.
      </p>
      <p>
        I want the site to show how I think through bugs, architecture,
        implementation details, and career growth—not only which tools I have
        used.
      </p>
    </div>

    <div class="essay-block essay-block-split" data-bleed-line>
      <section>
        <h2>Who I want it to help</h2>
        <ul class="plain-list">
          {audiences.map((item) => <li>{item}</li>)}
        </ul>
      </section>

      <section>
        <h2>What belongs here</h2>
        <ul class="plain-list">
          <li>Short notes from things I just learned.</li>
          <li>Deeper explanations after a concept becomes useful in practice.</li>
          <li>Project case studies with decisions and tradeoffs.</li>
          <li>Career reflections grounded in actual engineering work.</li>
        </ul>
      </section>
    </div>

    <div class="essay-block" data-bleed-line>
      <h2>What I optimize for</h2>
      <ul class="plain-list">
        {principles.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
