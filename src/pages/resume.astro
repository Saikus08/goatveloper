---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';

const summaryFacts = [
  `${resume.focusAreas.length} focus areas`,
  `${resume.skills.length} listed skills`,
  resume.pdfAvailable ? 'PDF ready' : 'PDF pending',
] as const;
---

<BaseLayout
  title="Resume"
  description={`${resume.name}'s software engineering resume.`}
>
  <section class="page-section page-header page-header-essay">
    <p class="eyebrow">Resume</p>
    <h1>{resume.name}</h1>
    <p class="page-lede">{resume.role} · {resume.location}</p>
    <div class="hero-actions">
      {
        resume.pdfAvailable ? (
          <a class="button primary" href={resume.pdfUrl} download>
            Download PDF resume
          </a>
        ) : (
          <span class="resume-status">PDF resume will appear here once added</span>
        )
      }
      <a class="button" href="/projects/">View projects</a>
    </div>
    <p class="resume-factline">{summaryFacts.join(' · ')}</p>
  </section>

  <section class="page-section resume-layout">
    <section class="resume-section" data-bleed-line>
      <h2>Profile</h2>
      <p>{resume.summary}</p>
    </section>

    <section class="resume-section resume-section-split" data-bleed-line>
      <div>
        <h2>Focus</h2>
        <ul class="plain-list">
          {resume.focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div>
        <h2>Skills</h2>
        <ul class="tag-list" aria-label="Skills">
          {resume.skills.map((skill) => <li><span class="tag">{skill}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="resume-section" data-bleed-line>
      <h2>Selected Projects</h2>
      <ul class="split-list">
        {
          resume.projects.map((project) => (
            <li>
              <strong>
                <a href={project.href}>{project.name}</a>
              </strong>
              <span>{project.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      resume.experience.length > 0 && (
        <section class="resume-section" data-bleed-line>
          <h2>Experience</h2>
          <ul class="split-list">
            {resume.experience.map((item) => (
              <li>
                <strong>{item.role}</strong>
                <span>{item.company}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      resume.education.length > 0 && (
        <section class="resume-section" data-bleed-line>
          <h2>Education</h2>
          <ul class="split-list">
            {resume.education.map((item) => (
              <li>
                <strong>{item.title}</strong>
                <span>{item.institution}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>
</BaseLayout>
