---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
import { site } from '../lib/site';

const summaryFacts = [
  '4+ years',
  'Open to remote roles',
  ...resume.languages,
] as const;
---

<BaseLayout
  title="Resume"
  description={`${resume.name}'s software engineering resume.`}
>
  <section class="page-section page-header page-header-essay">
    <p class="eyebrow">Resume</p>
    <h1>{resume.name}</h1>
    <p class="page-lede">{resume.role} · {resume.location}</p>
    <div class="hero-actions">
      {
        resume.pdfAvailable ? (
          <a class="button primary" href={resume.pdfUrl} download>
            Download PDF resume
          </a>
        ) : (
          <span class="resume-status">PDF resume will appear here once added</span>
        )
      }
      <a class="button" href={`mailto:${site.contact.email}`}>Email me</a>
      <a class="button" href={site.contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="button" href={site.contact.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <p class="resume-factline">{summaryFacts.join(' · ')}</p>
  </section>

  <section class="page-section resume-layout">
    <section class="resume-section" data-bleed-line>
      <h2>Profile</h2>
      <p>{resume.summary}</p>
    </section>

    {
      resume.experience.length > 0 && (
        <section class="resume-section" data-bleed-line>
          <h2>Experience</h2>
          <ul class="resume-entry-list">
            {resume.experience.map((item) => (
              <li class="resume-entry">
                <div class="resume-entry-heading">
                  <div>
                    <strong>{item.role}</strong>
                    <p class="resume-entry-company">
                      {item.company}
                      {item.location && <> · {item.location}</>}
                    </p>
                    {item.context && <p class="resume-entry-context">{item.context}</p>}
                  </div>
                  <span class="resume-entry-period">{item.period}</span>
                </div>
                <ul class="plain-list resume-highlights">
                  {item.highlights.map((highlight) => <li>{highlight}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      resume.education.length > 0 && (
        <section class="resume-section" data-bleed-line>
          <h2>Education</h2>
          <ul class="resume-entry-list">
            {resume.education.map((item) => (
              <li class="resume-entry">
                <div class="resume-entry-heading">
                  <div>
                    <strong>{item.title}</strong>
                    <p class="resume-entry-company">{item.institution}</p>
                  </div>
                  <span class="resume-entry-period">{item.period}</span>
                </div>
                <ul class="plain-list resume-highlights">
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="resume-section resume-section-split" data-bleed-line>
      <div>
        <h2>Focus</h2>
        <ul class="plain-list">
          {resume.focusAreas.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div>
        <h2>Skills</h2>
        <dl class="skill-groups">
          {resume.skills.map((group) => (
            <div class="skill-group">
              <dt class="micro-label">{group.label}</dt>
              <dd>
                <ul class="tag-list" aria-label={group.label}>
                  {group.items.map((skill) => <li><span class="tag">{skill}</span></li>)}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section class="resume-section" data-bleed-line>
      <h2>Selected Projects</h2>
      <ul class="split-list">
        {
          resume.projects.map((project) => (
            <li>
              <strong>
                {
                  project.href ? (
                    <a href={project.href}>{project.name}</a>
                  ) : (
                    project.name
                  )
                }
              </strong>
              <span>{project.description}</span>
            </li>
          ))
        }
      </ul>
    </section>

    {
      resume.links.length > 0 && (
        <section class="resume-section" data-bleed-line>
          <h2>Links</h2>
          <ul class="split-list">
            {resume.links.map((item) => (
              <li>
                <strong>
                  <a href={item.href} target="_blank" rel="noreferrer">
                    {item.label}
                  </a>
                </strong>
                <span>{item.href}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </section>
</BaseLayout>
